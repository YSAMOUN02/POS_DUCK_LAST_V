# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example

# IDE
/.idea
/.vscode
/.fleet
/.zed

# PHP / Laravel
/vendor
/storage/*.key
/storage/pail

# storage/framework/ contents are ignored via the nested .gitignore files in
# each subdirectory (Laravel convention), so the directories themselves stay in
# the repo. Do not add a blanket /storage/framework/* rule here — it hides the
# subdirs from git entirely, and a fresh clone then fails `composer install`
# with "Please provide a valid cache path."
/bootstrap/cache/*

# Database dumps written by `php artisan pos:truncate --backup`.
# These contain real customer names, phones and addresses — never commit them.
/storage/app/backups
*.sql

# Generated print artefacts (thermal receipt images)
/storage/app/private
/storage/app/receipts

# Node / Vite
/node_modules
/public/build
/public/hot

# Optional (your custom stuff)
/public/assets/startic_img/
/public/storage

# Misc
auth.json
.phpactor.json
.phpunit.result.cache
/.phpunit.cache
Homestead.json
Homestead.yaml